# =============================================================================
# Variables de entorno del laboratorio local (docs/plan/11 §3).
# Copiar a .env.local (que NUNCA va al repositorio):
#   cp .env.local.example .env.local
#
# Los hosts (db, minio, queue, mail) son nombres de servicio en la red del
# compose, con sus puertos canonicos. Para correr las apps FUERA de Docker,
# reemplazar por localhost y el puerto de HOST del bloque 4300-4307
# (ver docker-compose.dev.yml y docs/adr/0001): ej. db -> localhost:4302.
# =============================================================================

NODE_ENV=development

# Puertos de web (PORT, lo lee next) y api. Bloque dedicado del proyecto
# para no colisionar con otros proyectos de la maquina (ADR 0001).
PORT=4300
API_PORT=4301

# PostgreSQL. En AWS: la URL de RDS. app_rw NO tiene BYPASSRLS.
DATABASE_URL=postgresql://app_rw:devpass@db:5432/pymes

# S3 (MinIO en local). En AWS: S3_ENDPOINT vacio y S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# SQS (ElasticMQ en local). En AWS: vacio.
SQS_ENDPOINT=http://queue:9324

# Credenciales de juguete. En AWS: las provee el rol IAM de la instancia.
AWS_ACCESS_KEY_ID=devkey
AWS_SECRET_ACCESS_KEY=devsecret123

# CryptoService. En AWS: kms.
CRYPTO_PROVIDER=local

# SMTP saliente (Mailpit en local). En AWS: el SMTP del tenant.
SMTP_HOST=mail

# WhatsApp Cloud API. En AWS: https://graph.facebook.com
# (el fake-server wa-fake llega en fase 2; el valor ya queda definido)
WHATSAPP_API_URL=http://wa-fake:4000

# InvoicingProvider. En AWS: sandbox o el proveedor homologado real.
INVOICING_PROVIDER=fake

# Cloudflare Tunnel (opcional, docs/plan/11 §7). Nunca al repositorio.
# TUNNEL_TOKEN=
