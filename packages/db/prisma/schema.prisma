// Schema Prisma del modelo fisico (docs/plan/03). El DDL del doc 03 es el
// contrato: la migracion base (prisma/migrations) esta escrita a mano fiel a
// ese documento e incluye lo que Prisma no expresa (RLS, FORCE, indices
// parciales, CHECKs, triggers, vista). Cualquier diferencia se resuelve a
// favor del doc 03.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["control", "app"]
}

// ============================================================================
// Esquema `control`: plano de la plataforma
// ============================================================================

model PlatformUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         String // 'admin' (padmin) | 'agent' (pagent)
  totpSecret   Bytes?    @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  overridesCreated TenantFeatureOverride[]
  auditEntries     PlatformAuditLog[]

  @@map("platform_users")
  @@schema("control")
}

model Feature {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique // 'crm','catalog','scheduling','bot','chat_inbox','invoicing','payments'
  name String

  planFeatures PlanFeature[]
  overrides    TenantFeatureOverride[]

  @@map("features")
  @@schema("control")
}

model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique // 'standard','plus','enterprise'
  name         String
  monthlyPrice BigInt   @map("monthly_price")
  currency     String   @default("PYG") @db.Char(3)
  maxUsers     Int      @default(1) @map("max_users")
  maxBranches  Int      @default(1) @map("max_branches")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  planFeatures  PlanFeature[]
  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
  @@schema("control")
}

model PlanFeature {
  planId    String @map("plan_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid
  limits    Json   @default("{}")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
  @@schema("control")
}

model Tenant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName     String   @map("legal_name")
  tradeName     String?  @map("trade_name")
  ruc           String?  @unique
  status        String   @default("trial") // trial|active|suspended|closed
  currentPlanId String?  @map("current_plan_id") @db.Uuid
  branding      Json     @default("{}")
  timezone      String   @default("America/Asuncion")
  // CRM del dueño del sistema (ADR 0005): el tenant es la ficha del cliente.
  contactName   String?  @map("contact_name")
  contactEmail  String?  @map("contact_email") @db.Citext
  contactPhone  String?  @map("contact_phone")
  notes         String?
  /// Cuenta en desarrollo (2026-09-08): comprobantes simulados, sin bloqueos de datos fiscales.
  devMode       Boolean  @default(false) @map("dev_mode")
  /// Token de soporte (2026-09-22, ADR 0014): hash sha256(id:token); null = sin acceso de soporte.
  supportTokenHash      String?   @map("support_token_hash")
  supportTokenExpiresAt DateTime? @map("support_token_expires_at") @db.Timestamptz(6)
  supportTokenCreatedAt DateTime? @map("support_token_created_at") @db.Timestamptz(6)
  supportTokenCreatedBy String?   @map("support_token_created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  currentPlan      Plan?                   @relation(fields: [currentPlanId], references: [id])
  featureOverrides TenantFeatureOverride[]
  subscriptions    Subscription[]
  platformInvoices PlatformInvoice[]

  branches           Branch[]
  users              User[]
  customers          Customer[]
  contactPoints      CustomerContactPoint[]
  customFieldDefs    CustomFieldDef[]
  customerActivities CustomerActivity[]
  serviceCategories  ServiceCategory[]
  services           Service[]
  servicePhotos      ServicePhoto[]
  quotes             Quote[]
  appointments       Appointment[]
  conversations      Conversation[]
  invoices           Invoice[]
  botSettings          BotSettings?
  employeeFormSettings EmployeeFormSettings?
  botUsage           BotUsageMonthly[]
  botToolCalls       BotToolCall[]
  calendarBlocks     CalendarBlock[]
  employees          Employee[]
  integrationCreds   IntegrationCredential[]
  notificationEmails NotificationEmail[]

  appointmentServices AppointmentService[]
  customerFiscalIds   CustomerFiscalId[]
  settings            TenantSettings?
  charges             CustomerCharge[]
  statements          BillingStatement[]
  recurringBookings   RecurringBooking[]
  employeeAbsences    EmployeeAbsence[]
  returnRequests      ReturnRequest[]
  itemComponents      ItemComponent[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  @@map("tenants")
  @@schema("control")
}

model TenantFeatureOverride {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  featureId String   @map("feature_id") @db.Uuid
  enabled   Boolean
  extraFee  BigInt   @default(0) @map("extra_fee")
  limits    Json?
  note      String // motivo del acuerdo: obligatorio
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature      @relation(fields: [featureId], references: [id])
  creator PlatformUser @relation(fields: [createdBy], references: [id])

  @@unique([tenantId, featureId])
  @@map("tenant_feature_overrides")
  @@schema("control")
}

model Subscription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  status             String    @default("active") // active|past_due|cancelled
  agreedPrice        BigInt?   @map("agreed_price")
  currentPeriodStart DateTime  @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Date
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, status], map: "ix_subscriptions_tenant")
  @@map("subscriptions")
  @@schema("control")
}

model PlatformInvoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  status         String    @default("draft") // draft|issuing|approved|rejected|cancelled
  cdc            String?   @unique
  total          BigInt
  currency       String    @default("PYG") @db.Char(3)
  issuedAt       DateTime? @map("issued_at") @db.Timestamptz(6)
  kudePdfKey     String?   @map("kude_pdf_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("platform_invoices")
  @@schema("control")
}

model PlatformSetting {
  key              String   @id
  publicConfig     Json     @default("{}") @map("public_config")
  encryptedPayload Bytes?   @map("encrypted_payload")
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
  @@schema("control")
}

/// Padron de contribuyentes de la DNIT (ADR 0012): copia local del listado
/// publico de RUC (ruc | razon social | dv | ruc anterior | estado) que la
/// DNIT publica en 10 zips. Dato publico compartido por todos los tenants:
/// vive en `control`, sin tenant_id ni RLS. Lo mantiene un cron in-process
/// de la API y lo consultan los formularios al tipear un RUC.
model RucContribuyente {
  ruc         String   @id
  dv          String   @db.Char(1)
  razonSocial String   @map("razon_social")
  rucAnterior String?  @map("ruc_anterior")
  estado      String // ACTIVO | SUSPENSION TEMPORAL | BLOQUEADO | CANCELADO | CANCELADO DEFINITIVO
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("ruc_contribuyentes")
  @@schema("control")
}

/// Historial de descargas del padron (una fila por corrida; la ve el padmin).
model RucPadronRun {
  id          BigInt    @id @default(autoincrement())
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  status      String    @default("running") // running|ok|error
  triggeredBy String    @map("triggered_by") // cron|manual|startup
  actorId     String?   @map("actor_id") @db.Uuid
  filesOk     Int       @default(0) @map("files_ok")
  rowsRead    Int       @default(0) @map("rows_read")
  rowsChanged Int       @default(0) @map("rows_changed")
  error       String?

  @@map("ruc_padron_runs")
  @@schema("control")
}

model PlatformAuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  detail    Json?
  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor PlatformUser? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId], map: "ix_platform_audit_entity")
  @@map("platform_audit_log")
  @@schema("control")
}

// ============================================================================
// Esquema `app`: plano de los tenants. TODAS las tablas llevan tenant_id y RLS.
// ============================================================================

model Branch {
  id        String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  address   String?
  phone     String?
  /// Horario de atencion: { week: {"0".."6": [{from,to}...]}, closed_dates: [] }.
  schedule  Json      @default("{}")
  isMain    Boolean   @default(false) @map("is_main")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  branchAccess UserBranchAccess[]
  appointments Appointment[]
  invoices     Invoice[]
  quotes       Quote[]

  recurringBookings RecurringBooking[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  @@id([id])
  @@unique([tenantId, id]) // habilita FKs compuestas
  @@map("branches")
  @@schema("app")
  employees    Employee[]
}

model User {
  id           String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.Citext
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         String // root|admin|staff
  totpSecret   Bytes?    @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  branchAccess UserBranchAccess[]

  @@id([id])
  @@unique([tenantId, id])
  @@map("users")
  @@schema("app")
}

model UserBranchAccess {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_access")
  @@schema("app")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid // NULL para platform_users
  userId     String    @map("user_id") @db.Uuid // app.users o control.platform_users
  userScope  String    @map("user_scope") // tenant|platform
  tokenHash  Bytes     @unique @map("token_hash") // sha256 del token
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid // rotacion encadenada
  userAgent  String?   @map("user_agent")
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  replacedByToken RefreshToken?  @relation("rotation", fields: [replacedBy], references: [id])
  replaces        RefreshToken[] @relation("rotation")

  @@index([userScope, userId], map: "ix_refresh_user")
  @@map("refresh_tokens")
  @@schema("app")
}

model Customer {
  id             String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String?   @map("last_name")
  docType        String?   @map("doc_type") // ci|ruc|pasaporte
  docNumber      String?   @map("doc_number")
  rucDv          String?   @map("ruc_dv")
  email          String?   @db.Citext
  phoneE164      String?   @map("phone_e164") // '+5959xxxxxxxx'
  birthDate      DateTime? @map("birth_date") @db.Date
  address        String?
  notes          String?
  notifyWhatsapp Boolean   @default(true) @map("notify_whatsapp")
  notifyEmail    Boolean   @default(false) @map("notify_email")
  /// Resumen de la ultima conversacion inactiva (seguimiento comercial).
  lastConversationSummary String?   @map("last_conversation_summary")
  lastSummaryAt           DateTime? @map("last_summary_at") @db.Timestamptz(6)
  // CRM extendido (2026-08-26): valores de campos personalizados del tenant
  // (definidos en CustomFieldDef) + campos estandar estilo Bitrix.
  customData     Json      @default("{}") @map("custom_data")
  source         String? // whatsapp|instagram|facebook|recomendacion|web|local|otro
  sourceDetail   String?   @map("source_detail")
  companyName    String?   @map("company_name")
  jobTitle       String?   @map("job_title")
  city           String?
  tags           String[]  @default([])
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  marketingOptIn Boolean   @default(true) @map("marketing_opt_in")
  // Cuenta mensual (2026-09-07): per_service = factura por servicio (hoy);
  // monthly = los consumos se acumulan y se facturan al cierre del mes.
  billingMode    String    @default("per_service") @map("billing_mode")
  invoiceChannel String    @default("whatsapp") @map("invoice_channel") // whatsapp|email
  rating         Int?      @db.SmallInt
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  appointments  Appointment[]
  conversations Conversation[]
  invoices      Invoice[]
  quotes        Quote[]
  contactPoints CustomerContactPoint[]
  activities    CustomerActivity[]
  fiscalIds     CustomerFiscalId[]

  charges          CustomerCharge[]
  statements       BillingStatement[]
  recurringBookings RecurringBooking[]
  returnRequests ReturnRequest[]
  @@id([id])
  @@unique([tenantId, id])
  @@map("customers")
  @@schema("app")
}

// Multifield tipado del CRM (2026-08-26, estilo Bitrix): N telefonos, emails,
// webs y redes por cliente, con etiqueta y marca de principal.
model CustomerContactPoint {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  kind       String // phone|email|web|im
  label      String   @default("otro")
  value      String
  isPrimary  Boolean  @default(false) @map("is_primary")
  sort       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, customerId, kind], map: "contact_points_customer_idx")
  @@map("customer_contact_points")
  @@schema("app")
}

/// Servicios de un turno (2026-09-07): un turno puede combinar varios. El de
/// sort 0 es tambien appointments.service_id (compatibilidad con bot,
/// historial y facturar desde la agenda). duration_min queda congelado.
model AppointmentService {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid
  sort          Int    @default(0)
  durationMin   Int    @map("duration_min")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId, serviceId])
  @@index([tenantId, appointmentId], map: "appointment_services_appt_idx")
  @@map("appointment_services")
  @@schema("app")
}

/// Identidades fiscales de un cliente (2026-09-07): a nombre de quien
/// factura (RUC o CI + razon social / nombre). Un cliente puede tener varias
/// y pedir cada factura a un nombre distinto.
model CustomerFiscalId {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  docType    String    @map("doc_type") // ruc|ci|pasaporte
  docNumber  String    @map("doc_number")
  rucDv      String?   @map("ruc_dv")
  legalName  String    @map("legal_name")
  isDefault  Boolean   @default(false) @map("is_default")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer  @relation(fields: [tenantId, customerId], references: [tenantId, id])
  invoices Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId], map: "customer_fiscal_ids_customer_idx")
  @@map("customer_fiscal_ids")
  @@schema("app")
}

/// Ajustes del negocio que no son del bot ni de una integracion (2026-09-07):
/// cierre de la cuenta mensual y anticipacion de los turnos recurrentes.
/// Una fila por tenant (PK = tenant_id), mismo patron que bot_settings.
model TenantSettings {
  tenantId           String   @id @map("tenant_id") @db.Uuid
  monthlyCloseDay    Int      @default(1) @map("monthly_close_day") @db.SmallInt
  monthlyAutoInvoice Boolean  @default(false) @map("monthly_auto_invoice")
  recurringLeadDays  Int      @default(7) @map("recurring_lead_days") @db.SmallInt
  /// Inventario (2026-09-14): vender sin existencias y avisos de stock bajo.
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  lowStockAlerts     Boolean  @default(true) @map("low_stock_alerts")
  updatedBy          String?  @map("updated_by") @db.Uuid
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
  @@schema("app")
}

/// Consumos pendientes de un cliente con cuenta mensual (2026-09-07): lo
/// atendido y lo comprado en el mes, a facturar de una vez al cierre.
model CustomerCharge {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  serviceId     String?   @map("service_id") @db.Uuid
  appointmentId String?   @map("appointment_id") @db.Uuid
  description   String
  quantity      Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice     BigInt    @map("unit_price")
  taxRate       Int       @map("tax_rate") @db.SmallInt
  lineTotal     BigInt    @map("line_total")
  source        String // appointment|manual
  status        String    @default("pending") // pending|invoiced|void
  invoiceId     String?   @map("invoice_id") @db.Uuid
  chargedOn     DateTime  @default(dbgenerated("CURRENT_DATE")) @map("charged_on") @db.Date
  notes         String?
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  customer    Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id])
  service     Service?     @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  appointment Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  invoice     Invoice?     @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, customerId, status], map: "customer_charges_pending_idx")
  @@map("customer_charges")
  @@schema("app")
}

/// Resumen del mes por cliente (2026-09-07): uno por cliente y periodo; hace
/// idempotente el cierre automatico y guarda a quien se aviso y que factura salio.
model BillingStatement {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  period             String    @db.Char(7) // 'YYYY-MM'
  total              BigInt
  chargesCount       Int       @map("charges_count")
  notifiedCustomerAt DateTime? @map("notified_customer_at") @db.Timestamptz(6)
  notifiedOwnerAt    DateTime? @map("notified_owner_at") @db.Timestamptz(6)
  invoiceId          String?   @map("invoice_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id])
  invoice  Invoice? @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, customerId, period])
  @@map("billing_statements")
  @@schema("app")
}

/// Servicios recurrentes (2026-09-07): el cliente toma lo mismo cada semana,
/// cada dos semanas o cada mes; el sistema genera el turno con anticipacion y
/// le pide confirmacion por WhatsApp.
model RecurringBooking {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  employeeId      String?   @map("employee_id") @db.Uuid
  serviceIds      String[]  @map("service_ids") @db.Uuid
  frequency       String // weekly|biweekly|monthly
  weekday         Int?      @db.SmallInt // 0=domingo..6 (weekly/biweekly)
  dayOfMonth      Int?      @map("day_of_month") @db.SmallInt // 1..28 (monthly)
  timeLocal       String    @map("time_local") @db.Char(5) // 'HH:MM' hora del negocio
  durationMin     Int       @map("duration_min")
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime? @map("ends_on") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  lastGeneratedOn DateTime? @map("last_generated_on") @db.Date
  lastError       String?   @map("last_error")
  notes           String?
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  customer     Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id])
  branch       Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id])
  employee     Employee?     @relation(fields: [tenantId, employeeId], references: [tenantId, id])
  appointments Appointment[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId], map: "recurring_bookings_customer_idx")
  @@map("recurring_bookings")
  @@schema("app")
}

// Definicion de campos personalizados por tenant (2026-08-26): la ficha
// arranca con el minimo (nombre, apellido, celular, email) y cada negocio
// agrega lo que necesite; los valores viven en customers.custom_data.
model CustomFieldDef {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  entity     String // customer|service|appointment|invoice
  code       String
  label      String
  fieldType  String   @map("field_type") // text|number|date|boolean|list|money|url
  options    Json     @default("[]")
  required   Boolean  @default(false)
  showInForm Boolean  @default(true) @map("show_in_form")
  sort       Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, entity, code])
  @@map("custom_field_defs")
  @@schema("app")
}

// Timeline propio del cliente (2026-08-26): notas manuales y tareas de
// seguimiento con vencimiento, ademas de lo que ya aportan turnos,
// conversaciones y facturas.
model CustomerActivity {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  activityType   String    @map("activity_type") // nota|llamada|reunion|tarea|seguimiento
  body           String
  dueAt          DateTime? @map("due_at") @db.Timestamptz(6)
  doneAt         DateTime? @map("done_at") @db.Timestamptz(6)
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, customerId, createdAt(sort: Desc)], map: "activities_customer_idx")
  @@map("customer_activities")
  @@schema("app")
}

model ServiceCategory {
  id        String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  // Default de conveniencia al crear productos: el tipo real vive en Service.
  defaultKind String  @default("servicio") @map("default_kind")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  services Service[]

  @@id([id])
  @@unique([tenantId, id])
  @@map("service_categories")
  @@schema("app")
}

model Service {
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  name          String
  description   String?
  price         BigInt
  currency      String    @default("PYG") @db.Char(3)
  taxRate       Int       @default(10) @map("tax_rate") @db.SmallInt // 0|5|10
  // ADR 0009 fase 2: 'servicio' (durationMin = duracion de la tarea) o
  // 'item' (venta; con requiresMeeting el bot coordina una reunion inicial
  // de meetingMin minutos).
  kind            String  @default("servicio")
  durationMin     Int?    @map("duration_min")
  /// Minutos que aporta cuando se combina con otro servicio en el mismo turno
  /// (2026-09-07). NULL = la duracion completa.
  comboDurationMin Int?   @map("combo_duration_min")
  requiresMeeting Boolean @default(false) @map("requires_meeting")
  meetingMin      Int?    @map("meeting_min")
  /// Inventario (2026-09-14, ADR 0013): solo para items.
  sku           String?
  barcode       String?
  unit          String    @default("unidad")
  trackStock    Boolean   @default(false) @map("track_stock")
  minStock      Decimal   @default(0) @map("min_stock") @db.Decimal(12, 2)
  /// Costo promedio ponderado en guaranies (se recalcula en cada ingreso con costo).
  cost          BigInt    @default(0)
  /// Combo: se vende como uno y descuenta sus componentes.
  isCombo       Boolean   @default(false) @map("is_combo")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  category     ServiceCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  appointments Appointment[]
  appointmentServices AppointmentService[]
  invoiceItems InvoiceItem[]
  quoteItems   QuoteItem[]
  photos       ServicePhoto[]

  charges      CustomerCharge[]
  components   ItemComponent[] @relation("comboParent")
  componentOf  ItemComponent[] @relation("comboComponent")
  stockLevels  StockLevel[]
  stockMovements StockMovement[]
  returnRequests ReturnRequest[]
  @@id([id])
  @@unique([tenantId, id])
  @@map("services")
  @@schema("app")
}

// Fotos de catalogo (P1 2026-08-28): bytes en Postgres a escala laboratorio;
// la auditoria usa la variante row_audit_sin_data (jamas los bytes).
model ServicePhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  mime      String
  sizeBytes Int      @map("size_bytes")
  data      Bytes
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, serviceId, sort], map: "service_photos_service_idx")
  @@map("service_photos")
  @@schema("app")
}

model Appointment {
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  serviceId     String?   @map("service_id") @db.Uuid
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime  @map("ends_at") @db.Timestamptz(6)
  status        String    @default("pending") // pending|confirmed|completed|cancelled|no_show
  source        String    @default("panel") // panel|bot
  confirmedBy   String?   @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)
  invoiceId     String?   @map("invoice_id") @db.Uuid
  employeeId    String?   @map("employee_id") @db.Uuid
  googleEventId String?   @map("google_event_id")
  // Copia del evento en el calendario del empleado asignado (fase 3); solo
  // la del negocio (googleEventId) dispara cancelaciones reciprocas.
  employeeGoogleEventId String? @map("employee_google_event_id")
  // Recordatorio WhatsApp enviado (P1 2026-08-28): no se repite.
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz(6)
  // Turnos recurrentes (2026-09-07): de que regla nacio y si se le pidio al
  // cliente que confirme (SI/NO por WhatsApp, resuelto sin el bot).
  recurringBookingId      String?   @map("recurring_booking_id") @db.Uuid
  confirmationRequestedAt DateTime? @map("confirmation_requested_at") @db.Timestamptz(6)
  /// Se le aviso al cliente que su profesional no podra atenderlo (ausencia, 2026-09-08).
  absenceNotifiedAt       DateTime? @map("absence_notified_at") @db.Timestamptz(6)
  notes         String?
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id])
  customer Customer  @relation(fields: [tenantId, customerId], references: [tenantId, id])
  service  Service?  @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  employee Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, id])
  /// Todos los servicios del turno (2026-09-07); service_id es el principal.
  services AppointmentService[]
  recurringBooking RecurringBooking? @relation(fields: [tenantId, recurringBookingId], references: [tenantId, id])
  charges  CustomerCharge[]

  @@id([id])
  @@unique([tenantId, id])
  @@map("appointments")
  @@schema("app")
}

model Conversation {
  id             String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid // NULL hasta identificar
  phoneE164      String    @map("phone_e164")
  status         String    @default("bot_active") // bot_active|paused|agent|closed
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  // El proveedor de IA fallo y el bot dejo el aviso predefinido: la bandeja
  // la marca hasta que un humano (o el bot recuperado) vuelva a responder.
  needsHuman     Boolean   @default(false) @map("needs_human")
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  customer  Customer?     @relation(fields: [tenantId, customerId], references: [tenantId, id])
  messages  Message[]
  toolCalls BotToolCall[]

  returnRequests ReturnRequest[]
  @@id([id])
  @@unique([tenantId, id])
  @@unique([tenantId, phoneE164]) // una conversacion viva por numero
  @@map("conversations")
  @@schema("app")
}

model Message {
  id             BigInt   @id @default(autoincrement())
  tenantId       String   @map("tenant_id") @db.Uuid // denormalizado para RLS
  conversationId String   @map("conversation_id") @db.Uuid
  direction      String // in|out
  senderType     String   @map("sender_type") // customer|bot|agent|system
  senderUserId   String?  @map("sender_user_id") @db.Uuid
  body           String
  waMessageId    String?  @map("wa_message_id") // id de Meta, dedupe y estados
  status         String   @default("sent") // queued|sent|delivered|read|failed
  errorDetail    String?  @map("error_detail")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@index([conversationId, id(sort: Desc)], map: "ix_messages_conv")
  @@map("messages")
  @@schema("app")
}

model Invoice {
  id                String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  docType           String    @default("factura") @map("doc_type") // factura|nota_credito
  establishment     String?   @db.Char(3)
  expeditionPoint   String?   @map("expedition_point") @db.Char(3)
  docNumber         String?   @map("doc_number") @db.Char(7)
  timbrado          String?
  cdc               String? // 44 digitos al aprobar
  status            String    @default("draft") // draft|issuing|approved|rejected|cancelled|credited
  sifenResponseCode String?   @map("sifen_response_code")
  subtotal          BigInt    @default(0)
  taxTotal          BigInt    @default(0) @map("tax_total")
  total             BigInt    @default(0)
  currency          String    @default("PYG") @db.Char(3)
  cancelReason      String?   @map("cancel_reason")
  cancelledBy       String?   @map("cancelled_by") @db.Uuid
  issuedAt          DateTime? @map("issued_at") @db.Timestamptz(6)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// Respuesta de SIFEN al evento de cancelacion y aviso al cliente (2026-09-14).
  cancelSifenCode   String?   @map("cancel_sifen_code")
  cancelNotifiedAt  DateTime? @map("cancel_notified_at") @db.Timestamptz(6)
  /// Nota de credito: sus items volvieron al stock; motivo de la NC.
  restockedAt       DateTime? @map("restocked_at") @db.Timestamptz(6)
  creditReason      String?   @map("credit_reason")
  kudePdfKey        String?   @map("kude_pdf_key")
  relatedInvoiceId  String?   @map("related_invoice_id") @db.Uuid
  // A nombre de quien sale la factura (2026-09-07): congelado al crear el
  // borrador; NULL en facturas viejas = el documento del cliente.
  fiscalIdId        String?   @map("fiscal_id_id") @db.Uuid
  billingName       String?   @map("billing_name")
  billingDocType    String?   @map("billing_doc_type") // ruc|ci|pasaporte
  billingDocNumber  String?   @map("billing_doc_number")
  billingRucDv      String?   @map("billing_ruc_dv")
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  branch         Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id])
  customer       Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id])
  fiscalId       CustomerFiscalId? @relation(fields: [tenantId, fiscalIdId], references: [tenantId, id])
  relatedInvoice Invoice?      @relation("credit", fields: [tenantId, relatedInvoiceId], references: [tenantId, id])
  creditNotes    Invoice[]     @relation("credit")
  returnRequests ReturnRequest[] @relation("returnInvoice")
  returnCredits  ReturnRequest[] @relation("returnCreditNote")
  items          InvoiceItem[]
  payments       Payment[]
  quotes         Quote[]

  charges        CustomerCharge[]
  statements     BillingStatement[]
  @@id([id])
  @@unique([tenantId, id])
  @@map("invoices")
  @@schema("app")
}

model InvoiceItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid // denormalizado para RLS
  invoiceId   String  @map("invoice_id") @db.Uuid
  serviceId   String? @map("service_id") @db.Uuid // NULL para item libre
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   BigInt  @map("unit_price")
  taxRate     Int     @map("tax_rate") @db.SmallInt // 0|5|10
  lineTotal   BigInt  @map("line_total") // congelado: dato fiscal

  invoice Invoice  @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  service Service? @relation(fields: [tenantId, serviceId], references: [tenantId, id])

  @@index([invoiceId], map: "ix_items_invoice")
  @@map("invoice_items")
  @@schema("app")
}

// Presupuestos (P1 2026-08-28): espejo liviano de invoices SIN caracter
// fiscal; numeracion propia por tenant y conversion a borrador de factura.
model Quote {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  number     Int
  status     String    @default("draft") // draft|sent|accepted|rejected|invoiced
  validUntil DateTime? @map("valid_until") @db.Date
  notes      String?
  subtotal   BigInt    @default(0)
  taxTotal   BigInt    @default(0) @map("tax_total")
  total      BigInt    @default(0)
  currency   String    @default("PYG") @db.Char(3)
  invoiceId  String?   @map("invoice_id") @db.Uuid
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  branch   Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id])
  customer Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id])
  invoice  Invoice?    @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  items    QuoteItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, customerId, createdAt(sort: Desc)], map: "quotes_customer_idx")
  @@map("quotes")
  @@schema("app")
}

model QuoteItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  serviceId   String? @map("service_id") @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   BigInt  @map("unit_price")
  taxRate     Int     @map("tax_rate") @db.SmallInt // 0|5|10
  lineTotal   BigInt  @map("line_total")

  quote   Quote    @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)
  service Service? @relation(fields: [tenantId, serviceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, quoteId], map: "quote_items_quote_idx")
  @@map("quote_items")
  @@schema("app")
}

model Payment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid // denormalizado para RLS
  invoiceId    String   @map("invoice_id") @db.Uuid
  method       String // efectivo|transferencia|tarjeta|qr|otro
  amount       BigInt
  paidAt       DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  registeredBy String?  @map("registered_by") @db.Uuid
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@index([invoiceId], map: "ix_payments_invoice")
  @@map("payments")
  @@schema("app")
}

model BotSettings {
  tenantId            String   @id @map("tenant_id") @db.Uuid
  enabled             Boolean  @default(false)
  instructionsText    String?  @map("instructions_text")
  instructionsFileKey String?  @map("instructions_file_key")
  // Link fijo de videollamada del negocio (Meet/Zoom). NULL = el bot no
  // ofrece modalidad virtual (pedido 2026-08-17).
  virtualMeetingLink  String?  @map("virtual_meeting_link")
  accessCatalog       Boolean  @default(false) @map("access_catalog")
  accessHistory       Boolean  @default(false) @map("access_history")
  accessCustomerData  Boolean  @default(false) @map("access_customer_data")
  accessCalendar      Boolean  @default(false) @map("access_calendar")
  allowBooking        Boolean  @default(false) @map("allow_booking")
  autoConfirmBookings Boolean  @default(false) @map("auto_confirm_bookings")
  /// Consentimiento: sus instrucciones priman sobre la guia base (ADR 0008).
  instructionsOverride Boolean @default(false) @map("instructions_override")
  /// Opt-in: resumen automatico al pasar a inactiva (consume tokens).
  summariesEnabled    Boolean  @default(false) @map("summaries_enabled")
  // Recordatorios de turno por WhatsApp (P1 2026-08-28). Con envio real
  // fuera de la ventana de 24 h Meta exige plantilla aprobada del tenant.
  reminderEnabled      Boolean @default(false) @map("reminder_enabled")
  reminderHours        Int     @default(24) @map("reminder_hours") @db.SmallInt
  reminderTemplate     String? @map("reminder_template")
  reminderTemplateLang String  @default("es") @map("reminder_template_lang")
  monthlyTokenBudget  Int      @default(500000) @map("monthly_token_budget")
  updatedBy           String?  @map("updated_by") @db.Uuid
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("bot_settings")
  @@schema("app")
}

/// Ledger de consumo IA por tenant y mes (doc 05 §6, doc 09 R9; ADR 0006).
model BotUsageMonthly {
  tenantId     String   @map("tenant_id") @db.Uuid
  period       String // YYYY-MM en la zona del tenant
  inputTokens  BigInt   @default(0) @map("input_tokens")
  outputTokens BigInt   @default(0) @map("output_tokens")
  turns        Int      @default(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, period])
  @@map("bot_usage_monthly")
  @@schema("app")
}

// Ficha de RRHH (ADR 0009): empleado != usuario del panel. Solo los
// bookable participan de la agenda; salary visible solo root/admin.
model Employee {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  ciNumber         String?   @map("ci_number")
  birthDate        DateTime? @map("birth_date") @db.Date
  phone            String?
  email            String?   @db.Citext
  address          String?
  position         String?
  hiredAt          DateTime? @map("hired_at") @db.Date
  ipsNumber        String?   @map("ips_number")
  /// Texto libre viejo; reemplazado por los 3 campos desglosados (expand-and-contract).
  emergencyContact String?   @map("emergency_contact")
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")
  /// Datos que pide el Ministerio de Trabajo (2026-08-28).
  maritalStatus    String?   @map("marital_status")
  childrenCount    Int?      @map("children_count") @db.SmallInt
  salary           BigInt?
  notes            String?
  bookable         Boolean   @default(true)
  isActive         Boolean   @default(true) @map("is_active")
  // Horario propio (mismo formato que Branch.schedule); null = el de la sucursal.
  schedule         Json?
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  branch         Branch?                 @relation(fields: [tenantId, branchId], references: [tenantId, id])
  appointments   Appointment[]
  calendarBlocks CalendarBlock[]
  credentials    IntegrationCredential[]

  recurringBookings RecurringBooking[]
  absences          EmployeeAbsence[]
  @@unique([tenantId, id])
  @@index([tenantId, isActive, bookable], map: "employees_tenant_idx")
  @@map("employees")
  @@schema("app")
}

/// Ausencia de un empleado (2026-09-08): del dia starts_on al ends_on
/// (null = hasta nuevo aviso). Lo saca de la disponibilidad y dispara el
/// aviso a los clientes con turno en el periodo.
model EmployeeAbsence {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  startsOn   DateTime  @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on") @db.Date
  reason     String?
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, startsOn], map: "employee_absences_employee_idx")
  @@map("employee_absences")
  @@schema("app")
}

/// Campos obligatorios de la planilla de empleados, definidos por el admin
/// de cada tenant (2026-08-28). Nombre y apellido son siempre obligatorios
/// (piso tecnico); esta lista cubre el resto de los campos de la ficha.
model EmployeeFormSettings {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  requiredFields String[] @map("required_fields")
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("employee_form_settings")
  @@schema("app")
}

// Bloqueos importados del Google Calendar del tenant (ADR 0007 fase C):
// eventos ajenos al sistema que restan disponibilidad de la agenda.
model CalendarBlock {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid // NULL = todo el tenant
  // NULL = bloquea todo el negocio (calendario del tenant); con valor solo
  // saca a ese empleado de la franja (su Google personal, fase 3).
  employeeId    String?  @map("employee_id") @db.Uuid
  googleEventId String   @map("google_event_id")
  startsAt      DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(6)
  summary       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, id])

  // La unicidad real es un indice NULLS NOT DISTINCT (migracion 20260818).
  @@unique([tenantId, googleEventId, employeeId], map: "calendar_blocks_tenant_event_employee_key")
  @@index([tenantId, startsAt, endsAt], map: "calendar_blocks_rango")
  @@map("calendar_blocks")
  @@schema("app")
}

// Trazabilidad persistente de las herramientas del bot (auditoria 2026-08-07):
// antes solo quedaba en los logs del contenedor y se perdia con el redeploy.
model BotToolCall {
  id             BigInt   @id @default(autoincrement())
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  tool           String
  args           Json     @default("{}")
  ok             Boolean
  detail         String? // resultado (ok) o mensaje de error, truncado
  durationMs     Int      @default(0) @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id])

  @@index([tenantId, conversationId, id(sort: Desc)], map: "bot_tool_calls_conv_idx")
  @@map("bot_tool_calls")
  @@schema("app")
}

model IntegrationCredential {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  type             String // whatsapp|smtp|sifen|google_calendar|payment
  // NULL = credencial del negocio; con valor, conexion propia del empleado
  // (hoy solo google_calendar, fase 3 del ADR 0009).
  employeeId       String?  @map("employee_id") @db.Uuid
  encryptedPayload Bytes    @map("encrypted_payload") // envelope encryption (doc 05)
  publicConfig     Json     @default("{}") @map("public_config")
  isActive         Boolean  @default(true) @map("is_active")
  updatedBy        String   @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, id])

  // La unicidad real es un indice NULLS NOT DISTINCT (migracion 20260818).
  @@unique([tenantId, type, employeeId], map: "integration_credentials_tenant_type_employee_key")
  @@map("integration_credentials")
  @@schema("app")
}

model NotificationEmail {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String   @db.Citext
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@map("notification_emails")
  @@schema("app")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorType   String   @default("user") @map("actor_type") // user|bot|system|platform
  action      String
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  // Auditoria de seguridad (2026-09-07): une cada cambio con la accion HTTP
  // que lo causo (control.action_log.request_id) y registra el navegador.
  requestId   String?  @map("request_id") @db.Uuid
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)], map: "ix_audit_tenant")
  @@index([tenantId, entity, entityId], map: "ix_audit_entity")
  @@map("audit_log")
  @@schema("app")
}

/// Registro de acciones (auditoria de seguridad, 2026-09-07): toda peticion
/// que cambia algo, de los paneles de clientes y del portal admin, mas los
/// intentos de login: quien, desde que IP y navegador, que, cuando, como
/// termino y que datos mando (con contraseñas y tokens ocultos). Los cambios
/// fila a fila quedan en app.audit_log unidos por request_id.
model ActionLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now()) @db.Timestamptz(6)
  requestId   String?  @map("request_id") @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorScope  String   @map("actor_scope") // tenant|platform|anon
  actorRole   String?  @map("actor_role")
  actorEmail  String?  @map("actor_email")
  ip          String?
  userAgent   String?  @map("user_agent")
  method      String
  path        String
  route       String?
  status      Int
  durationMs  Int      @default(0) @map("duration_ms")
  body        Json?
  errorTitle  String?  @map("error_title")

  @@index([at(sort: Desc)], map: "ix_action_log_at")
  @@index([tenantId, at(sort: Desc)], map: "ix_action_log_tenant")
  @@index([actorUserId, at(sort: Desc)], map: "ix_action_log_actor")
  @@index([requestId], map: "ix_action_log_request")
  @@map("action_log")
  @@schema("control")
}

/// Pedido de devolucion (2026-09-14): lo registra el bot o el panel; una
/// persona lo revisa, decide y lo completa (nota de credito y/o reingreso).
model ReturnRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  invoiceId      String?   @map("invoice_id") @db.Uuid
  serviceId      String?   @map("service_id") @db.Uuid
  description    String
  reason         String?
  status         String    @default("requested") // requested|reviewing|approved|rejected|completed
  resolution     String?
  handledBy      String?   @map("handled_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  creditNoteId   String?   @map("credit_note_id") @db.Uuid
  restockedAt    DateTime? @map("restocked_at") @db.Timestamptz(6)
  createdVia     String    @default("panel") @map("created_via") // bot|panel
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  customer     Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id])
  conversation Conversation? @relation(fields: [tenantId, conversationId], references: [tenantId, id])
  invoice      Invoice?      @relation("returnInvoice", fields: [tenantId, invoiceId], references: [tenantId, id])
  service      Service?      @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  creditNote   Invoice?      @relation("returnCreditNote", fields: [tenantId, creditNoteId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt(sort: Desc)], map: "return_requests_status_idx")
  @@index([tenantId, customerId], map: "return_requests_customer_idx")
  @@map("return_requests")
  @@schema("app")
}

/// Componente de un combo (2026-09-14): cantidad del item hijo por unidad del combo.
model ItemComponent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  parentServiceId    String   @map("parent_service_id") @db.Uuid
  componentServiceId String   @map("component_service_id") @db.Uuid
  quantity           Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  parent    Service @relation("comboParent", fields: [tenantId, parentServiceId], references: [tenantId, id], onDelete: Cascade)
  component Service @relation("comboComponent", fields: [tenantId, componentServiceId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, parentServiceId, componentServiceId])
  @@map("item_components")
  @@schema("app")
}

/// Existencia actual de un item en una sucursal (saldo materializado del libro).
model StockLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  branch  Branch  @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, serviceId, branchId])
  @@map("stock_levels")
  @@schema("app")
}

/// Libro de movimientos de stock (solo se agrega): kardex por item y sucursal.
model StockMovement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  kind          String // initial|purchase|sale|sale_reversal|return|adjustment|transfer_in|transfer_out
  quantity      Decimal  @db.Decimal(12, 2) // con signo
  unitCost      BigInt?  @map("unit_cost")
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(12, 2)
  referenceType String?  @map("reference_type") // invoice|credit_note|return_request|manual
  referenceId   String?  @map("reference_id") @db.Uuid
  note          String?
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  branch  Branch  @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, serviceId, createdAt(sort: Desc)], map: "stock_movements_service_idx")
  @@index([tenantId, branchId, createdAt(sort: Desc)], map: "stock_movements_branch_idx")
  @@index([tenantId, referenceType, referenceId], map: "stock_movements_ref_idx")
  @@map("stock_movements")
  @@schema("app")
}
